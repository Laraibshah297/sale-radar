# Copy to .env and fill in. Never commit .env.
SITE_NAME=Sale Radar
BASE_URL=https://saleradar.pk
DOMAIN=saleradar.pk
# generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
COOKIE_SECURE=1
POSTGRES_PASSWORD=change-me-too
# must use the same password as POSTGRES_PASSWORD
DATABASE_URL=postgresql+psycopg://saleradar:change-me-too@db:5432/saleradar
CONTACT_EMAIL=hello@saleradar.pk
# Freshness rules (hours)
STALE_HOURS=48
HIDE_HOURS=168
# Email for price alerts (optional; free tiers of Brevo / Zoho / Mailjet work)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=alerts@saleradar.pk
